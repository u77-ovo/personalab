APP_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use a publishable key. The legacy anon key is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Prefer the new secret key; the legacy service-role key remains supported.
# Never prefix either value with NEXT_PUBLIC_. Do not add one until a server feature needs it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set these only after the migration and two-account tests really pass.
SUPABASE_RLS_VERIFIED=false
SUPABASE_STORAGE_VERIFIED=false
APP_BASE_URL=http://localhost:3000
