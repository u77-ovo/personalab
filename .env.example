APP_MODE=demo
QWEN_API_KEY=
# Use the workspace-specific OpenAI-compatible base URL from Alibaba Cloud Model Studio.
# Example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-flash
AI_LIVE_ENABLED=false
AI_REQUESTS_PER_HOUR=10
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use a publishable key. The legacy anon key is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Prefer the new secret key; the legacy service-role key remains supported.
# Never prefix either value with NEXT_PUBLIC_. Do not add one until a server feature needs it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set these only after the migration and two-account tests really pass.
SUPABASE_RLS_VERIFIED=false
SUPABASE_STORAGE_VERIFIED=false
APP_BASE_URL=http://localhost:3000
